{
  "name": "gord-dsh-worktree",
  "version": "0.6.0",
  "description": "Git worktrees, Fast mode and a lightweight session task tray for DeepSeek Harness.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web",
    "git",
    "worktree",
    "preset",
    "fast-mode",
    "concurrency",
    "session",
    "task-monitor"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": false
    }
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "test": "GORD_WORKTREE_NO_BUNDLE_PATCH=1 node test/host-smoke.mjs && node test/client-smoke.mjs && node test/task-monitor-smoke.mjs && node test/patch-smoke.mjs && node test/concurrency-smoke.mjs && node test/preset-smoke.mjs && node test/regression-smoke.mjs",
    "patch:sidebar": "node tools/patch-sidebar.mjs",
    "unpatch:sidebar": "node tools/patch-sidebar.mjs --revert",
    "patch:concurrency": "node tools/patch-concurrency.mjs",
    "unpatch:concurrency": "node tools/patch-concurrency.mjs --revert",
    "check:concurrency": "node tools/patch-concurrency.mjs --check"
  },
  "engines": {
    "dsh": "^0.1.5-rc.1 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightosong/gord-dsh-worktree.git"
  },
  "homepage": "https://github.com/nightosong/gord-dsh-worktree",
  "devDependencies": {
    "js-yaml": "^4.3.2",
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-preset": "^0.1.5-rc.1 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.1 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1 || ^0.1.6-0 || ^0.1.7-0 || ^0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset": {
      "optional": true
    }
  }
}
